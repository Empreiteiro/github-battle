{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "outDir": "./dist-server",
    "rootDir": ".",
    "sourceMap": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server/**/*.ts", "netlify/functions/**/*.ts"]
}
